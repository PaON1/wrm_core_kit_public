# WRM Core Kit Default Configuration
# Copy this to config/core_kit.env and edit as needed.

# Root directory for WRM logs + structure
WRM_ROOT="$(pwd)"

# Inventory file (optional)
HOSTS_INI="hosts.ini"

# Ansible group name (optional)
GROUP="wrm_pi_nodes"

# How many pulse lines to tail for snapshot
TAIL_LINES=1500
